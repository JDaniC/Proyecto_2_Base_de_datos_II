  "reglas": [
    {
      "$expr": {
        "$cond": [
          {
            "$isArray": "$diagnosticos"
          },
          {
            "$eq": [
              {
                "$size": "$diagnosticos"
              },
              {
                "$size": {
                  "$setUnion": [
                    "$diagnosticos.diagnostico_id",
                    []
                  ]
                }
              }
            ]
          },
          false
        ]
      }
    },
    {
      "$expr": {
        "$cond": [
          {
            "$isArray": "$tratamientos"
          },
          {
            "$eq": [
              {
                "$size": "$tratamientos"
              },
              {
                "$size": {
                  "$setUnion": [
                    "$tratamientos.tratamiento_id",
                    []
                  ]
                }
              }
            ]
          },
          false
        ]
      }
    },
    {
      "$expr": {
        "$cond": [
          {
            "$eq": [
              {
                "$type": "$receta"
              },
              "missing"
            ]
          },
          true,
          {
            "$and": [
              {
                "$eq": [
                  "$receta.prescriptor_id",
                  "$solicitante_medico_id"
                ]
              },
              {
                "$cond": [
                  {
                    "$isArray": "$receta.medicamentos"
                  },
                  {
                    "$eq": [
                      {
                        "$size": "$receta.medicamentos"
                      },
                      {
                        "$size": {
                          "$setUnion": [
                            "$receta.medicamentos.medicamento_id",
                            []
                          ]
                        }
                      }
                    ]
                  },
                  false
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "$expr": {
        "$allElementsTrue": [
          {
            "$map": {
              "input": {
                "$ifNull": [
                  "$tratamientos",
                  []
                ]
              },
              "as": "t",
              "in": {
                "$or": [
                  {
                    "$eq": [
                      {
                        "$type": "$$t.fecha_inicio"
                      },
                      "missing"
                    ]
                  },
                  {
                    "$eq": [
                      {
                        "$type": "$$t.fecha_fin"
                      },
                      "missing"
                    ]
                  },
                  {
                    "$gte": [
                      "$$t.fecha_fin",
                      "$$t.fecha_inicio"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "$expr": {
        "$cond": [
          {
            "$isArray": "$diagnosticos"
          },
          {
            "$or": [
              {
                "$eq": [
                  {
                    "$size": "$diagnosticos"
                  },
                  0
                ]
              },
              {
                "$eq": [
                  {
                    "$size": {
                      "$filter": {
                        "input": "$diagnosticos",
                        "as": "d",
                        "cond": {
                          "$eq": [
                            "$$d.es_principal",
                            true
                          ]
                        }
                      }
                    }
                  },
                  1
                ]
              }
            ]
          },
          false
        ]
      }
    }
  ],
