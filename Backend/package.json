{
  "name": "proyecto-2-bases-datos-ii-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fundación HTTP hexagonal para Entrega II de Bases de Datos II.",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "architecture:check": "node scripts/verificar-arquitectura.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copiar-contrato.mjs",
    "build:test": "tsc -p tsconfig.test.json && node scripts/copiar-contrato.mjs dist-test/src",
    "lint": "npm run architecture:check && eslint src tests scripts eslint.config.mjs",
    "start": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "test": "npm run build:test && node --test dist-test/tests/runtime/*.test.js dist-test/tests/unitarios/*.test.js && node --test tests/contratos/*.test.mjs",
    "test:integration:sql": "node scripts/run-sql-uow-integration.mjs",
    "test:integration:nosql": "node scripts/run-nosql-uow-integration.mjs",
    "test:integration:pacientes:mongodb": "node scripts/run-pacientes-mongodb-integration.mjs",
    "test:integration:pacientes:firestore": "node scripts/run-pacientes-firestore-integration.mjs",
    "provision:cuenta": "npm run build && node --env-file-if-exists=.env scripts/provisionar-cuenta.mjs",
    "test:integration:historial": "node scripts/run-historial-integration.mjs",
    "test:integration:pacientes:ui": "node scripts/run-historial-integration.mjs --pacientes-ui",
    "test:integration:clinica:mongodb": "node scripts/run-clinica-mongodb-integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "mongodb": "7.7.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
