APP_ENV=development
HOST=127.0.0.1
PORT=3000
INSTITUTIONS=HOSPITAL_GENERAL,CLINICA_ODONTOLOGICA,LABORATORIO_CLINICO,CENTRO_MEDICO_PEDIATRICO
# Cuentas de aplicación; sus contraseñas se montan como archivos secretos.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DATABASE=hospital_general
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD_FILE=../Database/.docker/secrets/postgres_app_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=clinica_odontologica
MYSQL_USER=clinica_app
MYSQL_PASSWORD_FILE=../Database/.docker/secrets/mysql_app_password
MONGO_HOST=127.0.0.1
MONGO_PORT=27018
MONGO_DATABASE=laboratorio_clinico
MONGO_USER=laboratorio_app
MONGO_APP_PASSWORD_FILE=../Database/.docker/secrets/mongo_app_password
MONGO_REPLICA_SET=rs0
MONGO_DIRECT_CONNECTION=true
# Usa un proyecto demo- y ambos emuladores para desarrollo local.
FIRESTORE_PROJECT_ID=demo-bdii-pediatria
FIRESTORE_EMULATOR_HOST=127.0.0.1:8188
FIREBASE_AUTH_PROJECT_ID=demo-bdii-pediatria
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098
