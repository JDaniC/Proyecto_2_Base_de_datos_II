APP_ENV=development
HOST=127.0.0.1
PORT=3000
INSTITUTIONS=HOSPITAL_GENERAL,CLINICA_ODONTOLOGICA,LABORATORIO_CLINICO,CENTRO_MEDICO_PEDIATRICO
# Cuentas de aplicación; sus contraseñas se montan como archivos secretos.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DATABASE=hospital_general
POSTGRES_USER=hospital_app
POSTGRES_PASSWORD_FILE=../.docker/secrets/postgres_app_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=clinica_odontologica
MYSQL_USER=clinica_app
MYSQL_PASSWORD_FILE=../.docker/secrets/mysql_app_password
